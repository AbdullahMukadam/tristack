pub struct Config {
    pub app_name: String,
    pub port: u16,
}

impl Config {
    pub fn from_env() -> Self {
        dotenvy::dotenv().ok();
        let app_name = std::env::var("APP_NAME").unwrap_or_else(|_| "{{projectName}}".to_string());
        let port: u16 = std::env::var("PORT")
            .unwrap_or_else(|_| "8000".to_string())
            .parse()
            .expect("PORT must be a valid u16");
        Self { app_name, port }
    }
}