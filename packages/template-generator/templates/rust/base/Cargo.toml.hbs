[package]
name = "{{project_slug}}"
version = "0.1.0"
edition = "2021"

[dependencies]
dotenvy = "0.15"
serde_json = "1"
{{#if (ne orm "none")}}
serde = { version = "1", features = ["derive"] }
chrono = { version = "0.4", features = ["serde"] }
uuid = { version = "1", features = ["v4"] }
{{/if}}

{{#if (eq framework "axum")}}
axum = "0.8"
tokio = { version = "1", features = ["full"] }
{{else if (eq framework "actix-web")}}
actix-web = "4"
{{#if (eq orm "diesel")}}
tokio = { version = "1", features = ["rt"] }
{{/if}}
{{else if (eq framework "rocket")}}
rocket = { version = "0.5", features = ["json"] }
{{#if (eq orm "diesel")}}
tokio = { version = "1", features = ["rt"] }
{{/if}}
{{else if (eq framework "warp")}}
warp = "0.3"
tokio = { version = "1", features = ["full"] }
{{else if (eq framework "salvo")}}
{{#if (or (ne orm "none") (eq frontend "htmx"))}}
salvo = { version = "0.75", features = ["affix-state"] }
{{else}}
salvo = "0.75"
{{/if}}
tokio = { version = "1", features = ["full"] }
{{/if}}

{{#if (eq frontend "htmx")}}
askama = "0.14"
{{/if}}

{{#if (eq orm "seaorm")}}
{{#if (eq database "sqlite")}}
sea-orm = { version = "1", features = ["sqlx-sqlite", "runtime-tokio-rustls"] }
{{else if (eq database "postgres")}}
sea-orm = { version = "1", features = ["sqlx-postgres", "runtime-tokio-rustls"] }
{{else if (eq database "mysql")}}
sea-orm = { version = "1", features = ["sqlx-mysql", "runtime-tokio-rustls"] }
{{/if}}
{{else if (eq orm "diesel")}}
{{#if (eq database "sqlite")}}
diesel = { version = "2", features = ["sqlite", "r2d2", "chrono"] }
libsqlite3-sys = { version = "0.32", features = ["bundled"] }
{{else if (eq database "postgres")}}
diesel = { version = "2", features = ["postgres", "r2d2", "chrono"] }
{{else if (eq database "mysql")}}
diesel = { version = "2", features = ["mysql", "r2d2", "chrono"] }
{{/if}}
{{else if (eq orm "sqlx-rust")}}
{{#if (eq database "sqlite")}}
sqlx = { version = "0.8", features = ["runtime-tokio", "sqlite", "chrono"] }
{{else if (eq database "postgres")}}
sqlx = { version = "0.8", features = ["runtime-tokio", "tls-rustls", "postgres", "chrono"] }
{{else if (eq database "mysql")}}
sqlx = { version = "0.8", features = ["runtime-tokio", "tls-rustls", "mysql", "chrono"] }
{{/if}}
{{/if}}
{{#if (eq framework "salvo")}}

[dev-dependencies]
salvo = { version = "0.75", features = ["test"] }
{{/if}}
{{#if (includes addons "clippy")}}

[lints.clippy]
all = { level = "warn", priority = -1 }
dbg_macro = "warn"
todo = "warn"
unwrap_used = "warn"
{{/if}}
