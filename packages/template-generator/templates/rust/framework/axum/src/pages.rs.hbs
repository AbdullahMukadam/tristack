use axum::extract::State;
{{#if (ne orm "none")}}
use axum::http::StatusCode;
use axum::response::{Html, IntoResponse, Response};
{{else}}
use axum::response::Html;
{{/if}}

{{#if (ne orm "none")}}
use crate::service;
{{/if}}
use crate::views;
use crate::AppState;

pub async fn index(State(state): State<AppState>) -> Html<String> {
    Html(views::index(&state.app_name))
}

pub async fn now() -> Html<String> {
    Html(views::now())
}
{{#if (ne orm "none")}}

pub async fn items(State(state): State<AppState>) -> Response {
    match service::list_items(&state.db).await {
        Ok(items) => Html(views::items(&items)).into_response(),
        Err(err) => (StatusCode::INTERNAL_SERVER_ERROR, err.to_string()).into_response(),
    }
}
{{/if}}
