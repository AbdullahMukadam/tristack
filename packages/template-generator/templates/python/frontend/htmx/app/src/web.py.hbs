{{#if (eq framework "fastapi")}}
from pathlib import Path
{{#if (and (ne orm "none") (ne orm "tortoise"))}}
from typing import Annotated
{{/if}}

{{#if (and (ne orm "none") (ne orm "tortoise"))}}
from fastapi import APIRouter, Depends, Request
{{else}}
from fastapi import APIRouter, Request
{{/if}}
from fastapi.responses import HTMLResponse
from fastapi.templating import Jinja2Templates

from .config import get_settings
{{#if (and (ne orm "none") (ne orm "tortoise"))}}
from .db import AsyncSession, get_session
{{/if}}
{{#if (ne orm "none")}}
from .services.items import list_items
{{/if}}

settings = get_settings()

web_router = APIRouter()

templates = Jinja2Templates(directory=str(Path(__file__).resolve().parent / "templates"))


@web_router.get("/", response_class=HTMLResponse, include_in_schema=False)
async def home(request: Request) -> HTMLResponse:
    return templates.TemplateResponse(request, "home.html", {"app_name": settings.app_name})
{{#if (eq orm "tortoise")}}


@web_router.get("/web/items", response_class=HTMLResponse, include_in_schema=False)
async def items_fragment(request: Request) -> HTMLResponse:
    items = await list_items()
    return templates.TemplateResponse(request, "items.html", {"items": items})
{{else if (ne orm "none")}}


@web_router.get("/web/items", response_class=HTMLResponse, include_in_schema=False)
async def items_fragment(
    request: Request,
    session: Annotated[AsyncSession, Depends(get_session)],
) -> HTMLResponse:
    items = await list_items(session)
    return templates.TemplateResponse(request, "items.html", {"items": items})
{{/if}}
{{else if (eq framework "litestar")}}
from litestar import get
{{#if (and (ne orm "none") (ne orm "tortoise"))}}
from litestar.di import NamedDependency, Provide
{{/if}}
from litestar.response import Template
from litestar.types import ControllerRouterHandler

from .config import get_settings
{{#if (and (ne orm "none") (ne orm "tortoise"))}}
from .db import AsyncSession, get_session
{{/if}}
{{#if (ne orm "none")}}
from .services.items import list_items
{{/if}}

settings = get_settings()


@get("/", sync_to_thread=False, include_in_schema=False)
def home() -> Template:
    return Template(template_name="home.html", context={"app_name": settings.app_name})
{{#if (eq orm "tortoise")}}


@get("/web/items", include_in_schema=False)
async def items_fragment() -> Template:
    items = await list_items()
    return Template(template_name="items.html", context={"items": items})
{{else if (ne orm "none")}}


@get(
    "/web/items",
    include_in_schema=False,
    dependencies={"session": Provide(get_session)},
)
async def items_fragment(session: NamedDependency[AsyncSession]) -> Template:
    items = await list_items(session)
    return Template(template_name="items.html", context={"items": items})
{{/if}}


web_routes: list[ControllerRouterHandler] = [home{{#if (ne orm "none")}}, items_fragment{{/if}}]
{{else if (eq framework "flask")}}
from flask import Blueprint, Flask, render_template

from .config import get_settings
{{#if (and (ne orm "none") (ne orm "tortoise"))}}
from .db import SessionLocal
{{/if}}
{{#if (ne orm "none")}}
from .services.items import list_items
{{/if}}

settings = get_settings()

web_bp = Blueprint("web", __name__)


@web_bp.get("/")
def home() -> str:
    return render_template("home.html", app_name=settings.app_name)
{{#if (eq orm "tortoise")}}


@web_bp.get("/web/items")
async def items_fragment() -> str:
    items = await list_items()
    return render_template("items.html", items=items)
{{else if (ne orm "none")}}


@web_bp.get("/web/items")
async def items_fragment() -> str:
    async with SessionLocal() as session:
        items = await list_items(session)
    return render_template("items.html", items=items)
{{/if}}


def register_web_blueprints(app: Flask) -> None:
    app.register_blueprint(web_bp)
{{/if}}
