{{#if (eq framework "fastapi")}}
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from pathlib import Path

from fastapi import FastAPI
from fastapi.staticfiles import StaticFiles

from .api.router import api_router
from .config import get_settings
{{#if (and (ne orm "none") (eq migrations "none"))}}
from .db import close_db, init_db
{{else if (ne orm "none")}}
from .db import close_db
{{/if}}
from .exceptions import register_exception_handlers
from .middleware import add_middleware
from .web import web_router

settings = get_settings()


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
{{#if (and (ne orm "none") (eq migrations "none"))}}
    await init_db()
{{/if}}
    yield
{{#if (ne orm "none")}}
    await close_db()
{{/if}}


def create_app() -> FastAPI:
    app = FastAPI(title=settings.app_name, lifespan=lifespan)
    add_middleware(app)
    register_exception_handlers(app)
    app.include_router(api_router)
    app.include_router(web_router)
    static_dir = Path(__file__).resolve().parent.parent / "static"
    app.mount("/static", StaticFiles(directory=static_dir), name="static")
    return app


app = create_app()
{{else if (eq framework "litestar")}}
from pathlib import Path

from litestar import Litestar
from litestar.config.cors import CORSConfig
from litestar.plugins.jinja import JinjaTemplateEngine
from litestar.static_files import create_static_files_router
from litestar.template import TemplateConfig

from .api.v1.router import health
from .api.v1.router import router as v1_router
from .config import get_settings
{{#if (and (ne orm "none") (eq migrations "none"))}}
from .db import close_db, init_db
{{else if (ne orm "none")}}
from .db import close_db
{{/if}}
from .exceptions import exception_handlers
from .web import web_routes

settings = get_settings()


def create_app() -> Litestar:
    pkg_dir = Path(__file__).resolve().parent
    return Litestar(
        route_handlers=[
            health,
            v1_router,
            *web_routes,
            create_static_files_router(path="/static", directories=[pkg_dir.parent / "static"]),
        ],
        debug=settings.debug,
        cors_config=CORSConfig(allow_origins=settings.cors_origins),
        template_config=TemplateConfig(directory=pkg_dir / "templates", engine=JinjaTemplateEngine),
        exception_handlers=exception_handlers,
{{#if (and (ne orm "none") (eq migrations "none"))}}
        on_startup=[init_db],
{{/if}}
{{#if (ne orm "none")}}
        on_shutdown=[close_db],
{{/if}}
    )


app = create_app()
{{else if (eq framework "flask")}}
{{#if (and (ne orm "none") (eq migrations "none"))}}
import asyncio
{{/if}}
from pathlib import Path

from flask import Flask

from .api.v1.router import register_v1_blueprints
from .config import get_settings
{{#if (and (ne orm "none") (eq migrations "none"))}}
from .db import init_db
{{/if}}
from .exceptions import register_error_handlers
from .web import register_web_blueprints

settings = get_settings()


def create_app() -> Flask:
    pkg_dir = Path(__file__).resolve().parent
    app = Flask(
        __name__,
        template_folder=pkg_dir / "templates",
        static_folder=pkg_dir.parent / "static",
        static_url_path="/static",
    )
    app.config["DEBUG"] = settings.debug
    register_error_handlers(app)
{{#if (and (ne orm "none") (eq migrations "none"))}}
    asyncio.run(init_db())
{{/if}}
    register_v1_blueprints(app)
    register_web_blueprints(app)
    return app


app = create_app()
{{/if}}
