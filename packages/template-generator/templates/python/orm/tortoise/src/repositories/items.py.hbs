from ..models import Item
from ..schemas.items import ItemResponse

async def create_item(*, name: str) -> ItemResponse:
    item = await Item.create(name=name)
    return ItemResponse(id=str(item.id), name=item.name, created_at=item.created_at)

async def list_items() -> list[ItemResponse]:
    items = await Item.all()
    return [ItemResponse(id=str(item.id), name=item.name, created_at=item.created_at) for item in items]