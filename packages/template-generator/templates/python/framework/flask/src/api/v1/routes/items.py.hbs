from flask import Blueprint, Response, jsonify, request

{{#if (ne orm "tortoise")}}
from ....db import SessionLocal
{{/if}}
from ....schemas.items import ItemCreate
from ....services.items import create_item, list_items

items_bp = Blueprint("items", __name__, url_prefix="/items")


@items_bp.get("/")
async def list_items_endpoint() -> Response:
{{#if (eq orm "tortoise")}}
    items = await list_items()
{{else}}
    async with SessionLocal() as session:
        items = await list_items(session)
{{/if}}
    return jsonify([item.model_dump(mode="json") for item in items])


@items_bp.post("/")
async def create_item_endpoint() -> tuple[Response, int]:
    payload = ItemCreate.model_validate(request.get_json())
{{#if (eq orm "tortoise")}}
    item = await create_item(payload)
{{else}}
    async with SessionLocal() as session:
        item = await create_item(session, payload)
{{/if}}
    return jsonify(item.model_dump(mode="json")), 201
