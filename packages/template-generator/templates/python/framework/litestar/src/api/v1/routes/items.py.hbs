from litestar import get, post
{{#if (ne orm "tortoise")}}
from litestar.di import NamedDependency, Provide

from ....db import AsyncSession, get_session
{{else}}

{{/if}}
from ....schemas.items import ItemCreate, ItemResponse
from ....services.items import create_item, list_items
{{#if (eq orm "tortoise")}}


@get("/items")
async def list_items_endpoint() -> list[ItemResponse]:
    return await list_items()


@post("/items", status_code=201)
async def create_item_endpoint(data: ItemCreate) -> ItemResponse:
    return await create_item(data)
{{else}}

session_dependency = {"session": Provide(get_session)}


@get("/items", dependencies=session_dependency)
async def list_items_endpoint(session: NamedDependency[AsyncSession]) -> list[ItemResponse]:
    return await list_items(session)


@post("/items", status_code=201, dependencies=session_dependency)
async def create_item_endpoint(
    data: ItemCreate, session: NamedDependency[AsyncSession]
) -> ItemResponse:
    return await create_item(session, data)
{{/if}}
