import logging

from litestar import Request
from litestar.response import Response
from litestar.status_codes import HTTP_400_BAD_REQUEST, HTTP_404_NOT_FOUND, HTTP_500_INTERNAL_SERVER_ERROR

logger = logging.getLogger(__name__)

class AppError(Exception):

    status_code = HTTP_400_BAD_REQUEST

class NotFoundError(AppError):
    status_code = HTTP_404_NOT_FOUND

def _handle_app_error(request: Request, exc: AppError) -> Response:
    return Response(content={"detail": str(exc)}, status_code=exc.status_code)

def _handle_unhandled(request: Request, exc: Exception) -> Response:
    logger.exception("Unhandled error: %s", exc)
    return Response(
        content={"detail": "Internal server error"},
        status_code=HTTP_500_INTERNAL_SERVER_ERROR,
    )

exception_handlers = {
    AppError: _handle_app_error,
    Exception: _handle_unhandled,
}