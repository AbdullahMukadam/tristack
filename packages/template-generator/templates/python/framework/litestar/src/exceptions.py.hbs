from typing import Any

from litestar import Request, Response
from litestar.status_codes import HTTP_400_BAD_REQUEST, HTTP_404_NOT_FOUND
from litestar.types import ExceptionHandlersMap


class AppError(Exception):
    status_code = HTTP_400_BAD_REQUEST


class NotFoundError(AppError):
    status_code = HTTP_404_NOT_FOUND


def _handle_app_error(request: Request[Any, Any, Any], exc: AppError) -> Response[Any]:
    return Response(content={"detail": str(exc)}, status_code=exc.status_code)


exception_handlers: ExceptionHandlersMap = {AppError: _handle_app_error}
