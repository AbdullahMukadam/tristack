"""FastAPI application entrypoint for {{projectName}}.

A factory pattern keeps the app import-safe (tests, uvicorn workers, and
the CLI can each build an instance without side effects).
"""
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

from fastapi import FastAPI

from .config import get_settings
from .exceptions import register_exception_handlers
from .middleware import add_middleware

settings = get_settings()


{{#if (and (ne orm "none") (eq migrations "none"))}}
@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    from .db import init_db

    await init_db()
    yield
{{else}}
@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    yield
{{/if}}


def create_app() -> FastAPI:
    """Application factory."""
    app = FastAPI(title=settings.app_name, lifespan=lifespan)

    add_middleware(app)
    register_exception_handlers(app)

    from .api.router import api_router

    app.include_router(api_router)

    return app


app = create_app()