[tool.poetry]
name = "{{project_slug}}"
version = "0.1.0"
description = {{#if (eq framework "none")}}"{{projectName}}"{{else}}"{{projectName}} - a {{framework}} project"{{/if}}
authors = []
{{#if (eq framework "django")}}
packages = [
    { include = "config" },
    { include = "apps" },
    { include = "templates" },
    { include = "static" },
]
{{else}}
packages = [{ include = "src" }]
{{/if}}

[tool.poetry.dependencies]
python = ">=3.12,<4.0"
{{#if (ne framework "django")}}
pydantic-settings = "^2.7"
{{/if}}
{{#if (eq framework "fastapi")}}
fastapi = "^0.115"
uvicorn = { extras = ["standard"], version = "^0.34" }
{{else if (eq framework "litestar")}}
{{#if (eq frontend "htmx")}}
litestar = { extras = ["jinja"], version = "^2.23" }
{{else}}
litestar = "^2.23"
{{/if}}
uvicorn = { extras = ["standard"], version = "^0.34" }
{{else if (eq framework "django")}}
django = "^5.1"
djangorestframework = "^3.15"
django-cors-headers = "^4.6"
gunicorn = "^23.0"
{{else if (eq framework "flask")}}
flask = { extras = ["async"], version = "^3.1" }
{{/if}}
{{#if (and (eq framework "django") (eq database "postgres"))}}
psycopg = { extras = ["binary"], version = "^3.2" }
{{else if (eq framework "django")}}
{{else if (eq orm "sqlmodel")}}
sqlmodel = ">=0.0.27,<0.1"
{{else if (eq orm "sqlalchemy")}}
sqlalchemy = { extras = ["asyncio"], version = "^2.0" }
{{else if (eq orm "tortoise")}}
tortoise-orm = "^1.1"
tzdata = "^2025.2"
{{/if}}
{{#if (and (ne framework "django") (ne framework "flask") (eq frontend "htmx"))}}
jinja2 = "^3.1"
{{/if}}
{{#if (eq migrations "alembic")}}
alembic = "^1.14"
{{/if}}
{{#if (and (ne framework "django") (eq database "postgres"))}}
asyncpg = "^0.30"
{{else if (and (ne framework "django") (eq database "mysql"))}}
asyncmy = "^0.2"
{{else if (and (ne framework "django") (eq database "sqlite"))}}
aiosqlite = "^0.20"
{{else if (and (eq framework "django") (eq database "mysql"))}}
mysqlclient = "^2.2"
{{/if}}

{{#if (or (includes addons "ruff") (includes addons "mypy") (includes addons "pytest"))}}
[tool.poetry.group.dev.dependencies]
{{#if (includes addons "ruff")}}
ruff = "^0.16"
{{/if}}
{{#if (includes addons "mypy")}}
{{#if (eq framework "django")}}
django-stubs = { extras = ["compatible-mypy"], version = "^6.1" }
djangorestframework-stubs = { extras = ["compatible-mypy"], version = "^3.18" }
{{else}}
mypy = "^2.4"
{{/if}}
{{/if}}
{{#if (includes addons "pytest")}}
pytest = "^9.1"
httpx = "^0.28"
{{/if}}

{{/if}}
[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"

[tool.pytest.ini_options]
pythonpath = ["."]
