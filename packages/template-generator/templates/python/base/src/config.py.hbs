from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict
{{#if (ne database "none")}}

DATABASE_NAME = "{{project_slug}}"
{{/if}}


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    app_name: str = "{{projectName}}"
    debug: bool = False
    cors_origins: list[str] = ["http://localhost:3000"]
{{#if (ne database "none")}}
{{#if (eq orm "tortoise")}}
    database_url: str = f"{{#if (eq database "sqlite")}}sqlite://./{DATABASE_NAME}.db{{else if (eq database "postgres")}}postgres://postgres:postgres@localhost:5432/{DATABASE_NAME}{{else}}mysql://root:password@localhost:3306/{DATABASE_NAME}{{/if}}"
{{else}}
    database_url: str = f"{{#if (eq database "sqlite")}}sqlite+aiosqlite:///./{DATABASE_NAME}.db{{else if (eq database "postgres")}}postgresql+asyncpg://postgres:postgres@localhost:5432/{DATABASE_NAME}{{else}}mysql+asyncmy://root:password@localhost:3306/{DATABASE_NAME}{{/if}}"
{{/if}}
{{/if}}


@lru_cache
def get_settings() -> Settings:
    return Settings()
