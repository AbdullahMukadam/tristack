[project]
name = "{{project_slug}}"
version = "0.1.0"
description = "{{projectName}} - a {{framework}} backend"
requires-python = ">=3.12"
dependencies = [
    "pydantic-settings",
{{#if (eq framework "fastapi")}}
    "fastapi",
    "uvicorn[standard]",
{{else if (eq framework "litestar")}}
    "litestar",
    "uvicorn[standard]",
{{else if (eq framework "django")}}
    "django",
    "djangorestframework",
    "django-cors-headers",
    "gunicorn",
{{else if (eq framework "flask")}}
    "flask",
{{/if}}
{{#if (eq orm "sqlmodel")}}
    "sqlmodel",
{{else if (eq orm "sqlalchemy")}}
    "sqlalchemy[asyncio]",
{{else if (eq orm "tortoise")}}
    "tortoise-orm",
{{/if}}
{{#if (eq migrations "alembic")}}
    "alembic",
{{/if}}
{{#if (eq database "postgres")}}
    "asyncpg",
{{else if (eq database "mysql")}}
    "asyncmy",
{{else if (eq database "sqlite")}}
    "aiosqlite",
{{/if}}
]

[project.optional-dependencies]
dev = [
    "pytest",
    "ruff",
    "mypy",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{project_slug}}"]
