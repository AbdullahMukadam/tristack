# Generated by TriStack. See https://github.com/air-verse/air for options.
root = "."
tmp_dir = "tmp"

[build]
  cmd = "go build -o ./tmp/{{project_slug}} ./cmd/api"
  bin = "./tmp/{{project_slug}}"
  include_ext = ["go", "html", "env"]
  exclude_dir = ["tmp", "bin", "vendor"]

[log]
  time = false

[misc]
  clean_on_exit = true