:root {
    color-scheme: light dark;
    --text: #1a1a1a;
    --muted: #666;
    --border: #d9d9d9;
    --accent: #f6a510;
}

* {
    box-sizing: border-box;
}

body {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    margin: 0;
    line-height: 1.5;
    color: var(--text);
}

header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--border);
}

header a {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
}

header a:hover {
    color: var(--accent);
}

main {
    max-width: 56rem;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
}

button {
    font: inherit;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
}

button:hover {
    border-color: var(--accent);
    color: var(--accent);
}

code {
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: #f2f2f2;
}

@media (prefers-color-scheme: dark) {
    :root {
        --text: #e8e8e8;
        --border: #333;
    }

    code {
        background: #222;
    }
}