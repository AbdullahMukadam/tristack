{
  "name": "tristack",
  "version": "0.1.5",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/fs-extra": "^11.0.4",
      "@types/node": "^26.1.2",
      "better-result": "^3.0.0",
      "handlebars": "^4.7.9",
      "oxfmt": "^0.63.0",
      "ts-morph": "^28.0.0",
      "tsdown": "^0.22.14",
      "typescript": "^6.0.3",
      "yaml": "^2.9.0",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:cli": "turbo run dev --filter=create-tristack",
    "cli": "cd apps/cli && node dist/cli.js",
    "dev:web": "turbo run dev --filter=web",
    "build:web": "turbo run build --filter=web",
    "build:cli": "turbo run build --filter=create-tristack",
    "test": "bun run check && cd apps/cli && bun test",
    "test:complete": "bun run check && bun run build && cd apps/cli && BTS_MATRIX_MODE=smoke BTS_BUILD_SAMPLES=1 bun test --bail=5",
    "lint": "turbo run lint",
    "check": "oxfmt . && oxlint .",
    "prepare": "lefthook install",
    "release:cut": "bun run scripts/cut-release.ts",
    "deploy:web": "turbo run deploy --filter=web",
    "generate": "turbo run generate-schema --filter=web",
    "deploy": "turbo run deploy --filter=web"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.2.0",
    "oxfmt": "catalog:",
    "oxlint": "1.78.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{js,mjs,cjs}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,jsonc}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.0"
}
